include README.md
include LICENSE
include CHANGELOG.md
include policy.json
recursive-include spec *.md *.py
recursive-include spec/vectors *.json allowed_signers README.md
recursive-include docs *.md
recursive-include skills *.md
recursive-include examples *.json *.sh *.md
recursive-include trust *
recursive-include mandate/data *.json
prune bench
prune .github
global-exclude *.pyc __pycache__ *.sbatch *.env .env* *.log
recursive-include tests *.py *.tsr *.json
recursive-include tools *.py *.sh
