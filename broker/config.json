{
  "host": "127.0.0.1",
  "port": 8899,
  "policy": "policy.json",
  "signers": "trust/allowed_signers",
  "revoked": "trust/revoked_signers",
  "ledger": "ledger.jsonl",
  "nonce_db": "broker/used.sqlite",
  "receipt_key": "broker/receipt_key",
  "broker_name": "gama-broker",
  "effects_dir": "effects",
  "outbox": "outbox",
  "journal_db": "broker/journal.sqlite",
  "lease_s": 60,
  "rate_limit_per_min": 120,
  "rate_burst": 20,
  "write": {
    "mode": "file",
    "effects_dir": "effects"
  },
  "payment": {
    "provider": "sandbox",
    "db": "payments.sqlite"
  },
  "smtp": {
    "mode": "dry_run",
    "host": "",
    "port": 587,
    "user": "",
    "password_env": "MANDATE_SMTP_PASSWORD",
    "from": "noreply@example.com",
    "starttls": true,
    "outbox": "outbox"
  },
  "erp": {
    "driver": "sqlite",
    "db": "erp.sqlite",
    "checks": {
      "payment.send": {
        "query": "SELECT invoice_total FROM vendors WHERE name = :target",
        "amount_field": "invoice_total",
        "tolerance_pct": 0.5
      },
      "order.create": {
        "query": "SELECT credit_limit FROM customers WHERE name = :target",
        "tolerance_pct": 0.0
      }
    },
    "derive": {
      "payment.send": {
        "query": "SELECT name, invoice_total, currency FROM vendors WHERE name = :target",
        "fields": {"counterparty": "name", "amount": "invoice_total", "currency": "currency"},
        "tolerance_pct": 0.5
      }
    }
  }
}
